  m_Script: {fileID: 11500000, guid: d7cd308d1b5fefe4e9cbd80ca7f63f8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialPanel: {fileID: 6981012853175297034}
  tutorialTitleText: {fileID: 6639767150815312655}
  tutorialTitle: {fileID: 7442207627629788266}
  tutorialDescription: {fileID: 995116701949220049}
  tutorialImage: {fileID: 6312330674490816741}
  leftButton: {fileID: 810905123600896268}
  rightButton: {fileID: 1626507368711325485}
  skipButton: {fileID: 0}
  startButton: {fileID: 0}
  readySetBagOverlay: {fileID: 0}
  startsGameTimer: 0
  titles:
  - THE AREA
  - THE GO-BAG
  - FINDING ITEMS
  - 'DRAGGING ITEMS INTO THE BAG '
  - THE WEIGHT METER
  - 'THE TIMER '
  - FINISHING THE PUZZLE
  - THE QUIZ
  descriptions:
  - "This is the house you\u2019ll explore. Each room may contain items you\u2019ll
    need for your go\u2011bag. Look carefully\u2014some items are in the kitchen,
    bathroom, or bedroom."
  - Items are placed in realistic locations. For example,  water is often in the
    kitchen. Hold an item to see its name and description.
  - Items are placed in realistic locations. For example,  water is often in the
    kitchen. Hold an item to see its name and description.
  - "To pack an item, drag it from the storage to your go\u2011bag. The item will
    move into your bag, and the weight meter will update."
  - "Your go\u2011bag can only carry a limited weight.  The meter shows how much
    weight you\u2019ve packed.  If you exceed the limit, you must remove an item
    before you can submit."
  - You have limited time to pack. The timer counts down during the whole puzzle.
  - "When you think you\u2019ve packed everything you need, approach the door. The
    game will ask \u2018Are you finished?\u2019 If you say yes, you\u2019ll move
    on to the quiz. If you say no, you can keep playing."
  - "After you finish packing, you\u2019ll answer a scenario based questions. Drag
    the correct item into the answer box. This helps you remember why each item matters."
  images:
  - {fileID: 21300000, guid: 9fa5f0ac1caf1af4eb5c4c67e553cb3b, type: 3}
  - {fileID: 21300000, guid: ed918cc173bb5274a84a26f89660075a, type: 3}
