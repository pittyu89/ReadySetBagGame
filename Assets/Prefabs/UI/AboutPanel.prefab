  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ready\u2011Set\u2011Bag! is a mobile game that teaches you how to pack
    an emergency go\u2011bag in case an earthquake happens. You explore different
    rooms of a house, find survival items, and drag them into your bag. You have
    to choose carefully because your bag can only hold a certain weight, and there
    is a timer counting down. The items in the game are based on the official PHIVOLCS
    (2025) Go Bag list. It is not a lecture or a poster \u2014 it is a game where
    you learn by playing."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cb9e1039b0a3b8246bd89a8ec45dc46c, type: 2}
  m_sharedMaterial: {fileID: 7669671442221834601, guid: cb9e1039b0a3b8246bd89a8ec45dc46c,
